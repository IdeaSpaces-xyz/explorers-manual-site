---
import { shortDate } from '../lib/dates';
import type { Update } from '../lib/content';

interface Props {
  post: Update;
  heading: 'h2' | 'h3';
}

const { post, heading: Heading } = Astro.props;
---

<article class="a-post" id={post.id}>
  <p class="t-date"><time datetime={post.date.toISOString()}>{shortDate(post.date)}</time></p>
  <Heading><a href={post.route}>{post.name}</a></Heading>
  <p class="a-summary">{post.summary}</p>
  <p class="a-more"><a href={post.route}>Read the story →</a></p>
  {
    post.map.length > 0 && (
      <div class="t-links">
        <p class="t-map-label">What changed, read more here</p>
        <ul>
          {post.map.map((link) => (
            <li>
              <a href={link.href} rel={link.external ? 'noopener noreferrer' : undefined}>
                {link.name}
                {link.external && ' ↗'}
              </a>
            </li>
          ))}
        </ul>
      </div>
    )
  }
</article>
